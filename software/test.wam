predicate(nrev/2,51,static,private,monofile,global,[
    switch_on_term(1,2,fail,4,fail),

label(1),
    try_me_else(3),

label(2),
    get_nil(0),
    get_nil(1),
    proceed,

label(3),
    trust_me_else_fail,

label(4),
    allocate(3),
    get_variable(y(1),1),
    get_list(0),
    unify_variable(y(0)),
    unify_variable(x(0)),
    put_variable(y(2),1),
    call(nrev/2),
    put_unsafe_value(y(2),0),
    put_list(1),
    unify_value(y(0)),
    unify_nil,
    put_value(y(1),2),
    deallocate,
    execute(conc/3)]).
